---
import '../styles/global.css';
import Starfield from '../components/Starfield';
interface Props { title?: string; description?: string }
const { title, description = 'A learning map: topics are suns, subtopics orbit them. Master a node to light the path outward.' } = Astro.props;
const base = import.meta.env.BASE_URL;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;600&family=Space+Grotesk:wght@400;500;700&display=swap" rel="stylesheet" />
    <title>{title ? `${title} · Orbit` : 'Orbit: a learning map'}</title>
  </head>
  <body>
    <Starfield client:only="preact" />
    <header class="site-head">
      <a class="logo" href={base}><span class="logo-dot" />orbit</a>
      <span class="muted tagline">Master a node to light the path outward.</span>
    </header>
    <main><slot /></main>
    <footer class="site-foot">
      <span>Learn it, master it, keep it.</span>
      <span class="muted">Designed and built by Clark Ngo.</span>
      <span class="muted credit">Music by <a href="https://pixabay.com/users/leberch-42823964/?utm_source=link-attribution&utm_medium=referral&utm_campaign=music&utm_content=626368">Nikita Kondrashev</a> from <a href="https://pixabay.com/?utm_source=link-attribution&utm_medium=referral&utm_campaign=music&utm_content=626368">Pixabay</a>.</span>
    </footer>
  </body>
</html>
